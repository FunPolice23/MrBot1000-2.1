# ── Agent Settings ──────────────────────────────────────────────
AGENT_NAME=MrBot1000
AGENT_USERNAME=
HEARTBEAT_INTERVAL=5
STARTUP_DELAY_SECS=0
AUTO_RESEARCH=true
RESEARCH_CACHE_TTL=120
RESEARCH_MAX_CHARS=5000
RESEARCH_MAX_TOTAL_CHARS=4000000
RESEARCH_BUNDLE_CHARS=60000
DEEP_READ_MAX_CHARS=8000
MAX_FILE_SIZE_MB=500
FILENAME_BLOCKLIST=config.yaml,.env,credentials.json,id_rsa
BLOCKED_MIME_TYPES=application/x-executable,application/x-sharedlib

# ── Thinking Mode ───────────────────────────────────────────────
THINKING_ENABLED=true            # false/0 to disable thinking parsing
THINK_LEVEL=med                  # chat model: low | med | high (reasoning depth)
MAIN_THINK_LEVEL=med             # main model: low | med | high
MAX_TOKENS=
MAIN_CONTEXT_TOKENS=
CHAT_CONTEXT_TOKENS=

# ── Pipeline (Earning Automation) ───────────────────────────────
PIPELINE_ENABLED=false
PIPELINE_ALLOW_WRITE=false
PIPELINE_ALLOW_SELF_IMPROVE=false

# ── Wallet & Payout ─────────────────────────────────────────────
ATOMIC_SOLANA_ADDRESS=
CASHAPP_TAG=

# ── Platform Tokens ─────────────────────────────────────────────
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
