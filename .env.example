UPWORK_REFRESH_TOKEN=

# ── Web Search ──────────────────────────────────────────────────
WEB_PROVIDER=ddgs
WEB_SEARCH_MAX_RESULTS=5
TAVILY_API_KEY=
BRAVE_API_KEY=

