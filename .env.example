# MrBot1000 2.1 — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ── LLM Provider API Keys ───────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# ── Dual Brain (llama.cpp) ──────────────────────────────────────
BIG_BRAIN_PROVIDER=llamacpp
BIG_BRAIN_URL=http://127.0.0.1:1234/v1
BIG_BRAIN_DEVICE=0
BIG_BRAIN_PORT=1234
BIG_BRAIN_CONTEXT=64768
BIG_BRAIN_GPU_LAYERS=-14
BIG_BRAIN_ENABLED=true
SMALL_BRAIN_PROVIDER=llamacpp
SMALL_BRAIN_URL=http://127.0.0.1:1235/v1
SMALL_BRAIN_DEVICE=1
SMALL_BRAIN_PORT=1235
SMALL_BRAIN_CONTEXT=16768
SMALL_BRAIN_GPU_LAYERS=-6
SMALL_BRAIN_ENABLED=true
DUAL_BRAIN_HEALTH_TIMEOUT=3

# ── Ollama (Local) ──────────────────────────────────────────────
DISABLE_OLLAMA=True
OLLAMA_MAIN_MODEL=llama3.2
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=180

# ── OpenAI ──────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=
OPENAI_MAIN_ENABLED=False
OPENAI_CHAT_ENABLED=False
OPENAI_HIDE=True
DISABLE_OPENAI=True

# ── Anthropic ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_CHAT_MODEL=
ANTHROPIC_MAIN_ENABLED=False
ANTHROPIC_CHAT_ENABLED=False
ANTHROPIC_HIDE=True
DISABLE_ANTHROPIC=True

