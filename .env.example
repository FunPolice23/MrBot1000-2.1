# MrBot1000 Environment Configuration
# ⚠️ KEEP THIS FILE SECRET - Never commit .env with real keys!

# ── Provider Settings ─────────────────────────────────────────────────────
OPENAI_API_KEY=# Optional: Your OpenAI API key
OPENAI_MODEL=your-openai-model-here

ANTHROPIC_API_KEY=# Optional: Your Anthropic API key
ANTHROPIC_MODEL=your-anthropic-model-here

# Ollama (Local LLM)
OLLAMA_MAIN_MODEL=your-ollama-main-model-here
OLLAMA_CHAT_MODEL=your-chat-model-here

# ── Dual Brain (v2.1 canonical contract: llama.cpp / llama-server) ──────────
# Big Brain   → RTX 5060 Ti (CUDA 0), port 1234
# Small Brain → GTX 1660 Super (CUDA 1), port 1235
# Provider kinds: llamacpp (default) | ollama | lmstudio. Ollama/LM Studio are
# explicit opt-ins, never silent defaults. The runtime is the single source of
# truth for role→endpoint/model/device.
BIG_BRAIN_PROVIDER=your-big-brain-provider-here
BIG_BRAIN_URL=your-big-brain-url-here
# BIG_BRAIN_MODEL=
BIG_BRAIN_DEVICE=your-big-brain-device-here
BIG_BRAIN_PORT=your-big-brain-port-here
BIG_BRAIN_CONTEXT=your-big-brain-context-here
# BIG_BRAIN_GPU_LAYERS=
BIG_BRAIN_ENABLED=your-big-brain-enabled-here
SMALL_BRAIN_PROVIDER=your-small-brain-provider-here
SMALL_BRAIN_URL=your-small-brain-url-here
# SMALL_BRAIN_MODEL=
SMALL_BRAIN_DEVICE=your-small-brain-device-here
SMALL_BRAIN_PORT=your-small-brain-port-here
SMALL_BRAIN_CONTEXT=your-small-brain-context-here
# SMALL_BRAIN_GPU_LAYERS=
SMALL_BRAIN_ENABLED=your-small-brain-enabled-here
# Health probe timeout for model servers (seconds).
DUAL_BRAIN_HEALTH_TIMEOUT=your-dual-brain-health-timeout-here


OLLAMA_MAIN_MODEL=your-ollama-main-model-here
OLLAMA_CHAT_MODEL=your-chat-model-here
OLLAMA_CHAT_GPU=your-ollama-chat-gpu-here

DISABLE_OPENAI=your-disable-openai-here
DISABLE_ANTHROPIC=your-disable-anthropic-here
DISABLE_OLLAMA=your-disable-ollama-here

# ── Wallet & Payout Settings ─────────────────────────────────────────────
ATOMIC_SOLANA_ADDRESS=       # Your Solana wallet for crypto payouts
CASHAPP_TAG=                 # Your Cash App $tag for USD payouts

# ── Agent Settings ───────────────────────────────────────────────────────
AGENT_NAME=your-agent-name-here
AGENT_USERNAME=your-agent-username-here

# ── Security Notes ───────────────────────────────────────────────────────
# - No cloud dependencies - all data stays local
# - API keys are read from .env file (git-ignored)
# - Ollama runs locally at 127.0.0.1:11434
# - Wallet addresses should be verified before use
# - Maximum payout amount: $10,000 (configurable in code)

# ── Advanced Settings ────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=your-max-file-size-mb-here
RESEARCH_MAX_CHARS=your-research-max-chars-here
DEEP_READ_MAX_CHARS=your-deep-read-max-chars-here
MAX_TOKENS=your-max-tokens-here

# ── Thinking Mode (v2.0.24) ──────────────────────────────────────────────
# Local Thinking models (e.g. LFM2.5-*Thinking) emit a <think>…</think> block.
# We split reasoning from the answer so the answer is never starved, and show
# the reasoning as a collapsible block in the chat window.
THINKING_ENABLED=your-thinking-enabled-here
THINK_LEVEL=your-think-level-here
MAIN_THINK_LEVEL=your-main-think-level-here

# ── Context / research limits (v2.0.24d) ───────────────────────────────
# Model context window in TOKENS. Auto-sizes per-call prompt budgets so a
# large research scan never overflows the model (exceed_context_size_error).
# Ollama may report 256k but the actual model can cap lower (128k, or 8k).
MAIN_CONTEXT_TOKENS=your-main-context-tokens-here
# Model context window (tokens). v2.0.24i: normally AUTO-DETECTED by querying
# `ollama show <model>` for the real 'context length' — so switching models
# (qwen3:0.6b=40960, llama3.2:1b=131072, gemma4:26b=262144, north-mini=500000)
# auto-scales thinking+answer to fit. Set these ONLY to override / for
# cloud providers (OpenAI/Anthropic) whose context differs from the local
# model. MAIN drives the CEO model; CHAT the chat model (falls back to MAIN).
CHAT_CONTEXT_TOKENS=your-chat-context-tokens-here
# Per-call timeout (seconds) for Ollama requests. A stalled Ollama (common on
# a 6GB GPU under concurrent load) would otherwise block the calling thread
# FOREVER and the app would appear to 'stop' with no error. Fail-fast so the
# retry/fallback path (or heartbeat guard) can recover.
OLLAMA_TIMEOUT=your-ollama-timeout-here
# SAFETY ceiling on total research text per scan (chars). Deliberately large.
# The chunker in manager.py ingests ALL research across multiple passes, so
# keep this high; a low value pre-truncates the scan and defeats chunking.
RESEARCH_MAX_TOTAL_CHARS=your-research-max-total-chars-here
# Max chars per research BUNDLE fed to the model in one gather pass (v2.0.24f).
# The scan is split into FILE-bundles (numbered list of files) each <= this
# size, so the model reads a manageable slice per pass instead of one giant
# wall of text. Tune to your model: ~60000 (15k tokens) suits a slow 2.6B on
# 6GB GPU; raise for a fast/large model, lower for a small one.
RESEARCH_BUNDLE_CHARS=your-research-bundle-chars-here
# num_predict budgets (answer headroom): low=500/1500, med=900/2500, high=1500/4000
# (chat/main). Raise via these overrides if you want longer reasoning:
# THINK_BUDGET_LOW=500
# THINK_BUDGET_MED=900
# THINK_BUDGET_HIGH=1500
HEARTBEAT_INTERVAL=your-heartbeat-interval-here
STARTUP_DELAY_SECS=your-startup-delay-secs-here
AUTO_RESEARCH=your-auto-research-here
RESEARCH_CACHE_TTL=your-research-cache-ttl-here
FILENAME_BLOCKLIST=your-filename-blocklist-here
BLOCKED_MIME_TYPES=your-blocked-mime-types-here

# ── Pipeline (earning automation) ───────────────────────────────────────
PIPELINE_ENABLED=your-pipeline-enabled-here
PIPELINE_ALLOW_WRITE=your-pipeline-allow-write-here
PIPELINE_ALLOW_SELF_IMPROVE=your-pipeline-allow-self-improve-here

# ── UI / Status Reporting ────────────────────────────────────────────────
COMPACT_STATUS_REPORTS=your-compact-status-reports-here

# ── Theme (read by theme_config.py; defaults applied if unset) ───────────
MRBOT_THEME_BG=your-mrbot-theme-bg-here
MRBOT_THEME_PANEL=your-mrbot-theme-panel-here
MRBOT_THEME_FG=your-mrbot-theme-fg-here
MRBOT_THEME_ACCENT=your-mrbot-theme-accent-here
MRBOT_THEME_HIGHLIGHT=your-mrbot-theme-highlight-here
MRBOT_THEME_DISABLED=your-mrbot-theme-disabled-here

# ── Platform Tokens (Optional) ───────────────────────────────────────────
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=

# Web search provider (optional - enriches gig discovery)
# ddgs = free, no key (default). tavily/brave = keyed API. none = disabled.
WEB_PROVIDER=your-web-provider-here
WEB_SEARCH_MAX_RESULTS=your-web-search-max-results-here
TAVILY_API_KEY=             # only if WEB_PROVIDER=tavily
BRAVE_API_KEY=              # only if WEB_PROVIDER=brave

# ── Additional Providers (v2.0.25, all OpenAI-compatible) ──────────────────
# Each is OPTIONAL and user-driven. Keys stay in .env (git-ignored). Ollama is
# default-enabled; any of these can be enabled/disabled or made primary.
OPENROUTER_API_KEY=# Optional: OpenRouter (routing to many models)
OPENROUTER_BASE_URL=your-openrouter-base-url-here
OPENROUTER_MODEL=# e.g. anthropic/claude-3.5-sonnet
DISABLE_OPENROUTER=your-disable-openrouter-here
GEMINI_API_KEY=# Optional: Google Gemini (via OpenAI-compatible API)
GEMINI_BASE_URL=your-gemini-base-url-here
GEMINI_MODEL=your-gemini-model-here
DISABLE_GEMINI=your-disable-gemini-here
GROQ_API_KEY=# Optional: Groq (fast open models)
GROQ_BASE_URL=your-groq-base-url-here
GROQ_MODEL=
DISABLE_GROQ=your-disable-groq-here
DEEPSEEK_API_KEY=# Optional: DeepSeek
DEEPSEEK_BASE_URL=your-deepseek-base-url-here
DEEPSEEK_MODEL=your-deepseek-model-here
DISABLE_DEEPSEEK=your-disable-deepseek-here
MISTRAL_API_KEY=# Optional: Mistral
MISTRAL_BASE_URL=your-mistral-base-url-here
MISTRAL_MODEL=
DISABLE_MISTRAL=your-disable-mistral-here
TOGETHER_API_KEY=# Optional: Together AI
TOGETHER_BASE_URL=your-together-base-url-here
TOGETHER_MODEL=
DISABLE_TOGETHER=your-disable-together-here
# Local OpenAI-compatible servers (set BASE_URL to enable; blank disables)
VLLM_BASE_URL=# e.g. http://localhost:8000/v1
VLLM_API_KEY=
VLLM_MODEL=
DISABLE_VLLM=your-disable-vllm-here
LM_STUDIO_BASE_URL=# e.g. http://localhost:1234/v1
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL=
DISABLE_LM_STUDIO=your-disable-lm-studio-here
KOBOLDCPP_BASE_URL=# e.g. http://localhost:5001
KOBOLDCPP_API_KEY=
KOBOLDCPP_MODEL=
DISABLE_KOBOLDCPP=your-disable-koboldcpp-here
