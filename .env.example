# MrBot1000 Environment Configuration
# This template is safe to publish. Copy it to .env and keep real keys private.

# ── Provider Settings ─────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (Local LLM)
# Optional Ollama fallback models. Set DISABLE_OLLAMA=false to use them.
OLLAMA_MAIN_MODEL=llama3.2
OLLAMA_CHAT_MODEL=your-chat-model-here

# ── Dual Brain (v2.1 canonical contract: llama.cpp / llama-server) ──────────
# Big Brain   → RTX 5060 Ti (CUDA 0), port 1234
# Small Brain → GTX 1660 Super (CUDA 1), port 1235
# Provider kinds: llamacpp (default) | ollama | lmstudio. Ollama/LM Studio are
# explicit opt-ins, never silent defaults. The runtime is the single source of
# truth for role→endpoint/model/device.
BIG_BRAIN_PROVIDER=llamacpp
BIG_BRAIN_URL=http://127.0.0.1:1234/v1
# BIG_BRAIN_MODEL=
BIG_BRAIN_DEVICE=0
BIG_BRAIN_PORT=1234
# GPU-backed Big Brain context. Reduce this when system RAM or VRAM is limited.
BIG_BRAIN_CONTEXT=32768
# BIG_BRAIN_GPU_LAYERS=
BIG_BRAIN_ENABLED=true
SMALL_BRAIN_PROVIDER=llamacpp
SMALL_BRAIN_URL=http://127.0.0.1:1235/v1
# SMALL_BRAIN_MODEL=
SMALL_BRAIN_DEVICE=1
# Set SMALL_BRAIN_GPU_LAYERS=0 to run Jacob entirely on CPU/system RAM when
# GPU 1 is unavailable. Leave blank for automatic GPU offload.
# SMALL_BRAIN_GPU_LAYERS=0
SMALL_BRAIN_PORT=1235
# Leave this unset for automatic defaults: 32768 with GPU offload, 4096 when
# SMALL_BRAIN_GPU_LAYERS=0. Set an explicit value only when the hardware can
# sustain it; CPU-only long context is usually the main latency bottleneck.
# SMALL_BRAIN_CONTEXT=32768
# SMALL_BRAIN_GPU_LAYERS=0
SMALL_BRAIN_ENABLED=true
# Health probe timeout for model servers (seconds).
DUAL_BRAIN_HEALTH_TIMEOUT=3
OLLAMA_CHAT_GPU=0

DISABLE_OPENAI=True
DISABLE_ANTHROPIC=True
DISABLE_OLLAMA=True

# ── Wallet & Payout Settings ─────────────────────────────────────────────
ATOMIC_SOLANA_ADDRESS=your-atomic-solana-address-here
CASHAPP_TAG=your-cashapp-tag-here

# ── Agent Settings ───────────────────────────────────────────────────────
AGENT_NAME=MrBot1000
AGENT_USERNAME=mrbot

# ── Security Notes ───────────────────────────────────────────────────────
# - No cloud dependencies - all data stays local
# - API keys are read from .env file (git-ignored)
# - Ollama runs locally at 127.0.0.1:11434
# - Wallet addresses should be verified before use
# - Maximum payout amount: $10,000 (configurable in code)

# ── Advanced Settings ────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=500
RESEARCH_MAX_CHARS=5000
DEEP_READ_MAX_CHARS=8000
MAX_TOKENS=your-max-tokens-here

# ── Thinking Mode (v2.0.24) ──────────────────────────────────────────────
# Local Thinking models (e.g. LFM2.5-*Thinking) emit a <think>…</think> block.
# We split reasoning from the answer so the answer is never starved, and show
# the reasoning as a collapsible block in the chat window.
THINKING_ENABLED=true            # false/0 to disable thinking parsing
THINK_LEVEL=med                  # chat model: low | med | high (reasoning depth)
MAIN_THINK_LEVEL=med             # main model: low | med | high

# ── Context / research limits (v2.0.24d) ───────────────────────────────
# Model context window in TOKENS. Auto-sizes per-call prompt budgets so a
# large research scan never overflows the model (exceed_context_size_error).
# Ollama may report 256k but the actual model can cap lower (128k, or 8k).
MAIN_CONTEXT_TOKENS=your-main-context-tokens-here
# Model context window (tokens). v2.0.24i: normally AUTO-DETECTED by querying
# `ollama show <model>` for the real 'context length' — so switching models
# (qwen3:0.6b=40960, llama3.2:1b=131072, gemma4:26b=262144, north-mini=500000)
# auto-scales thinking+answer to fit. Set these ONLY to override / for
# cloud providers (OpenAI/Anthropic) whose context differs from the local
# model. MAIN drives the CEO model; CHAT the chat model (falls back to MAIN).
CHAT_CONTEXT_TOKENS=your-chat-context-tokens-here
# Per-call timeout (seconds) for Ollama requests. A stalled Ollama (common on
# a 6GB GPU under concurrent load) would otherwise block the calling thread
# FOREVER and the app would appear to 'stop' with no error. Fail-fast so the
# retry/fallback path (or heartbeat guard) can recover.
OLLAMA_TIMEOUT=180
# Timeout for OpenAI-compatible streaming providers.
OPENAI_STREAM_TIMEOUT_SECONDS=120
# Dialogue bounds for long-running local sessions.
DIALOGUE_HISTORY_LIMIT=200
DIALOGUE_CONTEXT_CHAR_LIMIT=12000
DIALOGUE_TURN_MAX_TOKENS=your-dialogue-turn-max-tokens-here
DIALOGUE_MAX_EXCHANGES=0
# SAFETY ceiling on total research text per scan (chars). Deliberately large.
# The chunker in manager.py ingests ALL research across multiple passes, so
# keep this high; a low value pre-truncates the scan and defeats chunking.
RESEARCH_MAX_TOTAL_CHARS=4000000
# Max chars per research BUNDLE fed to the model in one gather pass (v2.0.24f).
# The scan is split into FILE-bundles (numbered list of files) each <= this
# size, so the model reads a manageable slice per pass instead of one giant
# wall of text. Tune to your model: ~60000 (15k tokens) suits a slow 2.6B on
# 6GB GPU; raise for a fast/large model, lower for a small one.
RESEARCH_BUNDLE_CHARS=60000
# num_predict budgets (answer headroom): low=500/1500, med=900/2500, high=1500/4000
# (chat/main). Raise via these overrides if you want longer reasoning:
# THINK_BUDGET_LOW=500
# THINK_BUDGET_MED=900
# THINK_BUDGET_HIGH=1500
HEARTBEAT_INTERVAL=5
STARTUP_DELAY_SECS=0
AUTO_RESEARCH=true
RESEARCH_CACHE_TTL=120
FILENAME_BLOCKLIST=config.yaml,.env,credentials.json,id_rsa
BLOCKED_MIME_TYPES=application/x-executable,application/x-sharedlib

# ── Pipeline (earning automation) ───────────────────────────────────────
PIPELINE_ENABLED=false
PIPELINE_ALLOW_WRITE=false
PIPELINE_ALLOW_SELF_IMPROVE=false

# ── UI / Status Reporting ────────────────────────────────────────────────
COMPACT_STATUS_REPORTS=true

# ── Theme (read by theme_config.py; defaults applied if unset) ───────────
MRBOT_THEME_BG='#121212'
MRBOT_THEME_PANEL='#2b3034'
MRBOT_THEME_FG='#009c9f'
MRBOT_THEME_ACCENT='#4fc3f7'
MRBOT_THEME_HIGHLIGHT='#7c4dff'
MRBOT_THEME_DISABLED='#6b7280'

# ── Platform Tokens (Optional) ───────────────────────────────────────────
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=your-upwork-client-secret-here
UPWORK_ACCESS_TOKEN=your-upwork-access-token-here
UPWORK_REFRESH_TOKEN=your-upwork-refresh-token-here

# Web search provider (optional - enriches gig discovery)
# ddgs = free, no key (default). tavily/brave = keyed API. none = disabled.
WEB_PROVIDER=ddgs
WEB_SEARCH_MAX_RESULTS=5
TAVILY_API_KEY=your-tavily-api-key-here
BRAVE_API_KEY=your-brave-api-key-here

# ── Additional Providers (v2.0.25, all OpenAI-compatible) ──────────────────
# Each is OPTIONAL and user-driven. Keys stay in .env (git-ignored). Ollama is
# default-enabled; any of these can be enabled/disabled or made primary.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=# e.g. anthropic/claude-3.5-sonnet
DISABLE_OPENROUTER=True
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-1.5-pro
DISABLE_GEMINI=True
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
DISABLE_GROQ=True
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DISABLE_DEEPSEEK=True
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=
DISABLE_MISTRAL=True
TOGETHER_API_KEY=your-together-api-key-here
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=
DISABLE_TOGETHER=True
# Local OpenAI-compatible servers (set BASE_URL to enable; blank disables)
VLLM_BASE_URL=# e.g. http://localhost:8000/v1
VLLM_API_KEY=your-vllm-api-key-here
VLLM_MODEL=
DISABLE_VLLM=True
LM_STUDIO_BASE_URL=# e.g. http://localhost:1234/v1
LM_STUDIO_API_KEY=your-lm-studio-api-key-here
LM_STUDIO_MODEL=
DISABLE_LM_STUDIO=True
KOBOLDCPP_BASE_URL=# e.g. http://localhost:5001
KOBOLDCPP_API_KEY=your-koboldcpp-api-key-here
KOBOLDCPP_MODEL=
DISABLE_KOBOLDCPP=True
OPENAI_CHAT_MODEL=
OPENAI_MAIN_ENABLED=False
OPENAI_CHAT_ENABLED=False
OPENAI_HIDE=True
ANTHROPIC_CHAT_MODEL=
ANTHROPIC_MAIN_ENABLED=False
ANTHROPIC_CHAT_ENABLED=False
ANTHROPIC_HIDE=True
OLLAMA_MODEL=your-main-model-here
OLLAMA_MAIN_ENABLED=False
OLLAMA_CHAT_ENABLED=False
OLLAMA_HIDE=True
OLLAMA_MAIN_GPU=-1
OPENROUTER_CHAT_MODEL=
OPENROUTER_MAIN_ENABLED=False
OPENROUTER_CHAT_ENABLED=False
OPENROUTER_HIDE=True
GEMINI_CHAT_MODEL=
GEMINI_MAIN_ENABLED=False
GEMINI_CHAT_ENABLED=False
GEMINI_HIDE=True
GROQ_CHAT_MODEL=
GROQ_MAIN_ENABLED=False
GROQ_CHAT_ENABLED=False
GROQ_HIDE=True
DEEPSEEK_CHAT_MODEL=
DEEPSEEK_MAIN_ENABLED=False
DEEPSEEK_CHAT_ENABLED=False
DEEPSEEK_HIDE=True
MISTRAL_CHAT_MODEL=
MISTRAL_MAIN_ENABLED=False
MISTRAL_CHAT_ENABLED=False
MISTRAL_HIDE=True
TOGETHER_CHAT_MODEL=
TOGETHER_MAIN_ENABLED=False
TOGETHER_CHAT_ENABLED=False
TOGETHER_HIDE=True
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_CHAT_MODEL=
DISABLE_NVIDIA=True
NVIDIA_MAIN_ENABLED=False
NVIDIA_CHAT_ENABLED=False
NVIDIA_HIDE=True
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VLLM_CHAT_MODEL=
VLLM_MAIN_ENABLED=False
VLLM_CHAT_ENABLED=False
VLLM_HIDE=True
LM_STUDIO_CHAT_MODEL=
LM_STUDIO_MAIN_ENABLED=False
LM_STUDIO_CHAT_ENABLED=False
LM_STUDIO_HIDE=True
KOBOLDCPP_CHAT_MODEL=
KOBOLDCPP_MAIN_ENABLED=False
KOBOLDCPP_CHAT_ENABLED=False
KOBOLDCPP_HIDE=True
MRBOT_FX_ANTIALIASING=True
MRBOT_FX_SOFT_SHADOWS=True
MRBOT_FX_HOVER_GLOW=True
MRBOT_FX_TRANSITIONS=True
MRBOT_FX_ANIMATIONS=True
MRBOT_FX_QUALITY=Quality
MRBOT_FX_RENDER_QUALITY=High
